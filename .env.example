# =============================================================================
# LogFlow — Shared Environment Configuration
# Copy this file to .env and fill in your values.
# ALL four team members must use these exact variable names so that
# producer.py, consumer.py, connection.py, and client.js resolve consistently.
# =============================================================================

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_BROKER=localhost:9092          # Internal Docker network uses kafka:9092
KAFKA_TOPIC_LOGS=logs                # Main log topic (4+ partitions)
KAFKA_TOPIC_DLQ=logs-dlq             # Dead Letter Queue topic (1 partition)
KAFKA_CONSUMER_GROUP=logflow-group  # Consumer group ID (Person 2)

# ---------------------------------------------------------------------------
# PostgreSQL  (matches service name "postgres" in docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logflow
POSTGRES_USER=logflow_user
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://logflow_user:changeme@localhost:5432/logflow

# ---------------------------------------------------------------------------
# FastAPI  (Person 3 — processing/api/main.py)
# ---------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ---------------------------------------------------------------------------
# React Dashboard  (Person 4 — dashboard/)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000   # Used in dashboard/src/api/client.js
